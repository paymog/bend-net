}\u{e5}\u{bd}\u{95}\u{e7}\u{ae}\u{80}\u{e4}\u{bb}\u{8b}\u{e8}\u{b4}\u{a8}\u{e9}\u{87}\u{8f}\u{e7}\u{94}\u{b7}\u{e4}\u{ba}\u{ba}\u{e5}\u{bd}\u{b1}\u{e5}\u{93}\u{8d}\u{e5}\u{bc}\u{95}\u{e7}\u{94}\u{a8}\u{e6}\u{8a}\u{a5}\u{e5}\u{91}\u{8a}\u{e9}\u{83}\u{a8}\u{e5}\u{88}\u{86}\u{e5}\u{bf}\u{ab}\u{e9}\u{80}\u{9f}\u{e5}\u{92}\u{a8}\u{e8}\u{af}\u{a2}\u{e6}\u{97}\u{b6}\u{e5}\u{b0}\u{9a}\u{e6}\u{b3}\u{a8}\u{e6}\u{84}\u{8f}\u{e7}\u{94}\u{b3}\u{e8}\u{af}\u{b7}\u{e5}\u{ad}\u{a6}\u{e6}\u{a0}\u{a1}\u{e5}\u{ba}\u{94}\u{e8}\u{af}\u{a5}\u{e5}\u{8e}\u{86}\u{e5}\u{8f}\u{b2}\u{e5}\u{8f}\u{aa}\u{e6}\u{98}\u{af}\u{e8}\u{bf}\u{94}\u{e5}\u{9b}\u{9e}\u{e8}\u{b4}\u{ad}\u{e4}\u{b9}\u{b0}\u{e5}\u{90}\u{8d}\u{e7}\u{a7}\u{b0}\u{e4}\u{b8}\u{ba}\u{e4}\u{ba}\u{86}\u{e6}\u{88}\u{90}\u{e5}\u{8a}\u{9f}\u{e8}\u{af}\u{b4}\u{e6}\u{98}\u{8e}\u{e4}\u{be}\u{9b}\u{e5}\u{ba}\u{94}\u{e5}\u{ad}\u{a9}\u{e5}\u{ad}\u{90}\u{e4}\u{b8}\u{93}\u{e9}\u{a2}\u{98}\u{e7}\u{a8}\u{8b}\u{e5}\u{ba}\u{8f}\u{e4}\u{b8}\u{80}\u{e8}\u{88}\u{ac}\u{e6}\u{9c}\u{83}\u{e5}\u{93}\u{a1}\u{e5}\u{8f}\u{aa}\u{e6}\u{9c}\u{89}\u{e5}\u{85}\u{b6}\u{e5}\u{ae}\u{83}\u{e4}\u{bf}\u{9d}\u{e6}\u{8a}\u{a4}\u{e8}\u{80}\u{8c}\u{e4}\u{b8}\u{94}\u{e4}\u{bb}\u{8a}\u{e5}\u{a4}\u{a9}\u{e7}\u{aa}\u{97}\u{e5}\u{8f}\u{a3}\u{e5}\u{8a}\u{a8}\u{e6}\u{80}\u{81}\u{e7}\u{8a}\u{b6}\u{e6}\u{80}\u{81}\u{e7}\u{89}\u{b9}\u{e5}\u{88}\u{ab}\u{e8}\u{ae}\u{a4}\u{e4}\u{b8}\u{ba}\u{e5}\u{bf}\u{85}\u{e9}\u{a1}\u{bb}\u{e6}\u{9b}\u{b4}\u{e6}\u{96}\u{b0}\u{e5}\u{b0}\u{8f}\u{e8}\u{af}\u{b4}\u{e6}\u{88}\u{91}\u{e5}\u{80}\u{91}\u{e4}\u{bd}\u{9c}\u{e4}\u{b8}\u{ba}\u{e5}\u{aa}\u{92}\u{e4}\u{bd}\u{93}\u{e5}\u{8c}\u{85}\u{e6}\u{8b}\u{ac}\u{e9}\u{82}\u{a3}\u{e4}\u{b9}\u{88}\u{e4}\u{b8}\u{80}\u{e6}\u{a0}\u{b7}\u{e5}\u{9b}\u{bd}\u{e5}\u{86}\u{85}\u{e6}\u{98}\u{af}\u{e5}\u{90}\u{a6}\u{e6}\u{a0}\u{b9}\u{e6}\u{8d}\u{ae}\u{e7}\u{94}\u{b5}\u{e8}\u{a7}\u{86}\u{e5}\u{ad}\u{a6}\u{e9}\u{99}\u{a2}\u{e5}\u{85}\u{b7}\u{e6}\u{9c}\u{89}\u{e8}\u{bf}\u{87}\u{e7}\u{a8}\u{8b}\u{e7}\u{94}\u{b1}\u{e4}\u{ba}\u{8e}\u{e4}\u{ba}\u{ba}\u{e6}\u{89}\u{8d}\u{e5}\u{87}\u{ba}\u{e6}\u{9d}\u{a5}\u{e4}\u{b8}\u{8d}\u{e8}\u{bf}\u{87}\u{e6}\u{ad}\u{a3}\u{e5}\u{9c}\u{a8}\u{e6}\u{98}\u{8e}\u{e6}\u{98}\u{9f}\u{e6}\u{95}\u{85}\u{e4}\u{ba}\u{8b}\u{e5}\u{85}\u{b3}\u{e7}\u{b3}\u{bb}\u{e6}\u{a0}\u{87}\u{e9}\u{a2}\u{98}\u{e5}\u{95}\u{86}\u{e5}\u{8a}\u{a1}\u{e8}\u{be}\u{93}\u{e5}\u{85}\u{a5}\u{e4}\u{b8}\u{80}\u{e7}\u{9b}\u{b4}\u{e5}\u{9f}\u{ba}\u{e7}\u{a1}\u{80}\u{e6}\u{95}\u{99}\u{e5}\u{ad}\u{a6}\u{e4}\u{ba}\u{86}\u{e8}\u{a7}\u{a3}\u{e5}\u{bb}\u{ba}\u{e7}\u{ad}\u{91}\u{e7}\u{bb}\u{93}\u{e6}\u{9e}\u{9c}\u{e5}\u{85}\u{a8}\u{e7}\u{90}\u{83}\u{e9}\u{80}\u{9a}\u{e7}\u{9f}\u{a5}\u{e8}\u{ae}\u{a1}\u{e5}\u{88}\u{92}\u{e5}\u{af}\u{b9}\u{e4}\u{ba}\u{8e}\u{e8}\u{89}\u{ba}\u{e6}\u{9c}\u{af}\u{e7}\u{9b}\u{b8}\u{e5}\u{86}\u{8c}\u{e5}\u{8f}\u{91}\u{e7}\u{94}\u{9f}\u{e7}\u{9c}\u{9f}\u{e7}\u{9a}\u{84}\u{e5}\u{bb}\u{ba}\u{e7}\u{ab}\u{8b}\u{e7}\u{ad}\u{89}\u{e7}\u{ba}\u{a7}\u{e7}\u{b1}\u{bb}\u{e5}\u{9e}\u{8b}\u{e7}\u{bb}\u{8f}\u{e9}\u{aa}\u{8c}\u{e5}\u{ae}\u{9e}\u{e7}\u{8e}\u{b0}\u{e5}\u{88}\u{b6}\u{e4}\u{bd}\u{9c}\u{e6}\u{9d}\u{a5}\u{e8}\u{87}\u{aa}\u{e6}\u{a0}\u{87}\u{e7}\u{ad}\u{be}\u{e4}\u{bb}\u{a5}\u{e4}\u{b8}\u{8b}\u{e5}\u{8e}\u{9f}\u{e5}\u{88}\u{9b}\u{e6}\u{97}\u{a0}\u{e6}\u{b3}\u{95}\u{e5}\u{85}\u{b6}\u{e4}\u{b8}\u{ad}\u{e5}\u{80}\u{8b}\u{e4}\u{ba}\u{ba}\u{e4}\u{b8}\u{80}\u{e5}\u{88}\u{87}\u{e6}\u{8c}\u{87}\u{e5}\u{8d}\u{97}\u{e5}\u{85}\u{b3}\u{e9}\u{97}\u{ad}\u{e9}\u{9b}\u{86}\u{e5}\u{9b}\u{a2}\u{e7}\u{ac}\u{ac}\u{e4}\u{b8}\u{89}\u{e5}\u{85}\u{b3}\u{e6}\u{b3}\u{a8}\u{e5}\u{9b}\u{a0}\u{e6}\u{ad}\u{a4}\u{e7}\u{85}\u{a7}\u{e7}\u{89}\u{87}\u{e6}\u{b7}\u{b1}\u{e5}\u{9c}\u{b3}\u{e5}\u{95}\u{86}\u{e4}\u{b8}\u{9a}\u{e5}\u{b9}\u{bf}\u{e5}\u{b7}\u{9e}\u{e6}\u{97}\u{a5}\u{e6}\u{9c}\u{9f}\u{e9}\u{ab}\u{98}\u{e7}\u{ba}\u{a7}\u{e6}\u{9c}\u{80}\u{e8}\u{bf}\u{91}\u{e7}\u{bb}\u{bc}\u{e5}\u{90}\u{88}\u{e8}\u{a1}\u{a8}\u{e7}\u{a4}\u{ba}\u{e4}\u{b8}\u{93}\u{e8}\u{be}\u{91}\u{e8}\u{a1}\u{8c}\u{e4}\u{b8}\u{ba}\u{e4}\u{ba}\u{a4}\u{e9}\u{80}\u{9a}\u{e8}\u{af}\u{84}\u{e4}\u{bb}\u{b7}\u{e8}\u{a7}\u{89}\u{e5}\u{be}\u{97}\u{e7}\u{b2}\u{be}\u{e5}\u{8d}\u{8e}"

def w6b6() -> String:
  "\u{e5}\u{ae}\u{b6}\u{e5}\u{ba}\u{ad}\u{e5}\u{ae}\u{8c}\u{e6}\u{88}\u{90}\u{e6}\u{84}\u{9f}\u{e8}\u{a7}\u{89}\u{e5}\u{ae}\u{89}\u{e8}\u{a3}\u{85}\u{e5}\u{be}\u{97}\u{e5}\u{88}\u{b0}\u{e9}\u{82}\u{ae}\u{e4}\u{bb}\u{b6}\u{e5}\u{88}\u{b6}\u{e5}\u{ba}\u{a6}\u{e9}\u{a3}\u{9f}\u{e5}\u{93}\u{81}\u{e8}\u{99}\u{bd}\u{e7}\u{84}\u{b6}\u{e8}\u{bd}\u{ac}\u{e8}\u{bd}\u{bd}\u{e6}\u{8a}\u{a5}\u{e4}\u{bb}\u{b7}\u{e8}\u{ae}\u{b0}\u{e8}\u{80}\u{85}\u{e6}\u{96}\u{b9}\u{e6}\u{a1}\u{88}\u{e8}\u{a1}\u{8c}\u{e6}\u{94}\u{bf}\u{e4}\u{ba}\u{ba}\u{e6}\u{b0}\u{91}\u{e7}\u{94}\u{a8}\u{e5}\u{93}\u{81}\u{e4}\u{b8}\u{9c}\u{e8}\u{a5}\u{bf}\u{e6}\u{8f}\u{90}\u{e5}\u{87}\u{ba}\u{e9}\u{85}\u{92}\u{e5}\u{ba}\u{97}\u{e7}\u{84}\u{b6}\u{e5}\u{90}\u{8e}\u{e4}\u{bb}\u{98}\u{e6}\u{ac}\u{be}\u{e7}\u{83}\u{ad}\u{e7}\u{82}\u{b9}\u{e4}\u{bb}\u{a5}\u{e5}\u{89}\u{8d}\u{e5}\u{ae}\u{8c}\u{e5}\u{85}\u{a8}\u{e5}\u{8f}\u{91}\u{e5}\u{b8}\u{96}\u{e8}\u{ae}\u{be}\u{e7}\u{bd}\u{ae}\u{e9}\u{a2}\u{86}\u{e5}\u{af}\u{bc}\u{e5}\u{b7}\u{a5}\u{e4}\u{b8}\u{9a}\u{e5}\u{8c}\u{bb}\u{e9}\u{99}\u{a2}\u{e7}\u{9c}\u{8b}\u{e7}\u{9c}\u{8b}\u{e7}\u{bb}\u{8f}\u{e5}\u{85}\u{b8}\u{e5}\u{8e}\u{9f}\u{e5}\u{9b}\u{a0}\u{e5}\u{b9}\u{b3}\u{e5}\u{8f}\u{b0}\u{e5}\u{90}\u{84}\u{e7}\u{a7}\u{8d}\u{e5}\u{a2}\u{9e}\u{e5}\u{8a}\u{a0}\u{e6}\u{9d}\u{90}\u{e6}\u{96}\u{99}\u{e6}\u{96}\u{b0}\u{e5}\u{a2}\u{9e}\u{e4}\u{b9}\u{8b}\u{e5}\u{90}\u{8e}\u{e8}\u{81}\u{8c}\u{e4}\u{b8}\u{9a}\u{e6}\u{95}\u{88}\u{e6}\u{9e}\u{9c}\u{e4}\u{bb}\u{8a}\u{e5}\u{b9}\u{b4}\u{e8}\u{ae}\u{ba}\u{e6}\u{96}\u{87}\u{e6}\u{88}\u{91}\u{e5}\u{9b}\u{bd}\u{e5}\u{91}\u{8a}\u{e8}\u{af}\u{89}\u{e7}\u{89}\u{88}\u{e4}\u{b8}\u{bb}\u{e4}\u{bf}\u{ae}\u{e6}\u{94}\u{b9}\u{e5}\u{8f}\u{82}\u{e4}\u{b8}\u{8e}\u{e6}\u{89}\u{93}\u{e5}\u{8d}\u{b0}\u{e5}\u{bf}\u{ab}\u{e4}\u{b9}\u{90}\u{e6}\u{9c}\u{ba}\u{e6}\u{a2}\u{b0}\u{e8}\u{a7}\u{82}\u{e7}\u{82}\u{b9}\u{e5}\u{ad}\u{98}\u{e5}\u{9c}\u{a8}\u{e7}\u{b2}\u{be}\u{e7}\u{a5}\u{9e}\u{e8}\u{8e}\u{b7}\u{e5}\u{be}\u{97}\u{e5}\u{88}\u{a9}\u{e7}\u{94}\u{a8}\u{e7}\u{bb}\u{a7