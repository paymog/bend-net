# Words of length 4, 256 to a block: word i of block b.
def w4.at3(hit: Bool, +b: U32, +i: U32) -> String:
  match hit:
    case True{}:
      String.take(String.drop(w4b3(), U32.to_nat((i * 4 : U32))), 4n)
    case False{}:
      ""

def w4.at2(hit: Bool, +b: U32, +i: U32) -> String:
  match hit:
    case True{}:
      String.take(String.drop(w4b2(), U32.to_nat((i * 4 : U32))), 4n)
    case False{}:
      w4.at3(U32.is_eq(b, 3), b, i)

